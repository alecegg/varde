# category<TAB>path regex<TAB>anchored line regex<TAB>reason
non-goal	^clis/code/.*$	^.*handoff.*$	The extraction-to-resolution pipeline phase keeps its handoff terminology.
non-goal	^clis/doc/.*$	^.*handoff.*$	Workflow artifact and skill cross-reference handoff kinds are unrelated to session notes.
non-goal	^clis/learn/README\.md$	^.*handoff.*$	The learn module documents a separate workflow handoff.
non-goal	^skills/(ledgers/varde-delivery\.json|tests/fixtures/flow-ledger/varde\.json)$	^.*handoff.*$	Workflow phase ledger entries retain their handoff phase.
non-goal	^skills/(README\.md|varde-agent-doc-authoring/references/criteria\.md|varde-learn/references/diagnose-current\.md)$	^.*handoff.*$	These documents use handoff for separate workflow or review senses.
non-goal	^skills/tests/(agent-review-correctness|spike-approved-fix-routing)\.sh$	^.*handoff.*$	These tests cover agent report and routing handoffs.
non-goal	^memory-bank/knowledge/decision/(cli-only-no-mcp|resolution-extends-handoff-model|resolution-graph-algorithms-scope)\.md$	^.*handoff.*$	These decisions describe unrelated workflow and resolution concepts.
non-goal	^memory-bank/knowledge/reference/resolution-graph-algorithms\.md$	^.*handoff.*$	The graph resolution description uses the pipeline handoff sense.
non-goal	^memory-bank/knowledge/reference/varde-superpowers-discussion\.md$	^.*(verdict handoff|reflect-handoff|Handoff resume).*$	The remaining mentions describe review and reflection workflow handoffs.
alias	^clis/(varde|workflow)/.*$	^.*(context_handoff|handoff_at_tokens|handoff_path|--handoff|alias = "handoff").*$	The old provider, config key, stored field, and flag remain aliases for one release.
legacy-read	^clis/(varde|workflow)/.*$	^.*(handoff\.md|handoffs\b|legacy.{0,16}handoff).*$	The resolver and migration retain reads of legacy session-note paths for one release.
migration-command	^clis/(varde|workflow)/.*$	^.*(migrate-session-notes|handoff\.md|handoffs/).*$	The migration command names the old source layout while moving notes.
legacy-read	^skills/(varde-change|varde-knowledge|shared)/.*$	^.*(handoff\.md|handoffs\b|legacy.{0,16}handoff).*$	Skill guidance and migration helpers describe legacy session-note paths.
migration-command	^skills/(varde-change|varde-knowledge|shared)/.*$	^.*(migrate-session-notes|handoff\.md|handoffs/).*$	Skill guidance documents the one-time migration command and source layout.
