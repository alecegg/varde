    {
      "id": "inventory-adjustment",
      "pair_group": "inventory-adjustment",
      "behaviour": "Apply stock movements to item quantities and report the final quantity for each item.",
      "input_domain": "Starting stock contains nonnegative integer quantities through 1,000,000,000; signed movements contain integer quantities from -1,000,000,000 through 1,000,000,000, and an item absent from starting stock begins at zero. Add movements by item across the union of names. If any final quantity is negative, reject the whole request with {\"error\":\"insufficient_stock\"}; otherwise return an array of {item, quantity} records sorted by ordinal ASCII item name.",
      "difficulty": "moderate",
      "over_comfort_monolith": true,
      "idiom_tags": [
        "error-handling",
        "transaction-safety"
      ],
      "cases": [
        {
          "input": {
            "stock": {
              "A": 2
            },
            "movements": {
              "A": 1
            }
          },
          "expected": [
            {
              "item": "A",
              "quantity": 3
            }
          ]
        },
        {
          "input": {
            "stock": {
              "A": 2
            },
            "movements": {
              "A": -2
            }
          },
          "expected": [
            {
              "item": "A",
              "quantity": 0
            }
          ]
        },
        {
          "input": {
            "stock": {},
            "movements": {}
          },
          "expected": []
        },
        {
          "input": {
            "stock": {
              "B": 1,
              "A": 4
            },
            "movements": {
              "A": -1,
              "B": 3
            }
          },
          "expected": [
            {
              "item": "A",
              "quantity": 3
            },
            {
              "item": "B",
              "quantity": 4
            }
          ]
        },
        {
          "input": {
            "stock": {
              "A": 1
            },
            "movements": {
              "A": -2
            }
          },
          "expected": {
            "error": "insufficient_stock"
          }
        },
        {
          "input": {
            "stock": {
              "A": 2,
              "B": 1
            },
            "movements": {
              "A": -1,
              "B": -2
            }
          },
          "expected": {
            "error": "insufficient_stock"
          }
        },
        {
          "input": {
            "stock": {
              "A": 0
            },
            "movements": {
              "B": 3
            }
          },
          "expected": [
            {
              "item": "A",
              "quantity": 0
            },
            {
              "item": "B",
              "quantity": 3
            }
          ]
        },
        {
          "input": {
            "stock": {
              "A": 5
            },
            "movements": {
              "A": 0
            }
          },
