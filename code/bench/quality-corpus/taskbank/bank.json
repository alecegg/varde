              "quantity": 1,
              "revenue": 2
            },
            {
              "product": "same",
              "quantity": 1,
              "revenue": 1
            }
          ]
        },
        {
          "input": [
            {
              "product": "K",
              "quantity": 7,
              "unit_price": 2.35
            }
          ],
          "expected": [
            {
              "product": "K",
              "quantity": 7,
              "revenue": 16.45
            }
          ]
        },
        {
          "input": [
            {
              "product": "",
              "quantity": 1,
