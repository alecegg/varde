  "tasks": [
    {
      "id": "price-order",
      "pair_group": "price-order",
      "behaviour": "Calculate the subtotal, discount, tax, and total for a list of order items.",
      "input_domain": "Items contain exact decimal prices >= 0 and positive integer quantities; calculate the raw subtotal, apply a 10% discount only when subtotal > 100, then calculate 8% tax on the discounted subtotal. Round subtotal, discount, tax, and total independently at their final field boundary to two decimals, half up away from zero; the supplied cases avoid exact half-cent ties. Total is the discounted subtotal plus the rounded tax.",
      "difficulty": "moderate",
      "over_comfort_monolith": true,
      "idiom_tags": [],
      "cases": [
        {
          "input": [
            [
              10,
              2
            ]
          ],
          "expected": {
            "subtotal": 20,
            "discount": 0,
            "tax": 1.6,
            "total": 21.6
          }
        },
        {
          "input": [
            [
              100,
              1
            ]
          ],
          "expected": {
            "subtotal": 100,
            "discount": 0,
            "tax": 8,
            "total": 108
          }
        },
        {
          "input": [
            [
              101,
              1
            ]
          ],
          "expected": {
            "subtotal": 101,
            "discount": 10.1,
            "tax": 7.27,
            "total": 98.17
          }
        },
        {
          "input": [
            [
              25,
              4
            ]
          ],
          "expected": {
            "subtotal": 100,
            "discount": 0,
            "tax": 8,
            "total": 108
          }
        },
        {
          "input": [
            [
              12.5,
              3
            ],
            [
              4,
              2
            ]
          ],
          "expected": {
            "subtotal": 45.5,
            "discount": 0,
            "tax": 3.64,
            "total": 49.14
          }
        },
        {
          "input": [],
          "expected": {
            "subtotal": 0,
            "discount": 0,
            "tax": 0,
            "total": 0
          }
        },
        {
          "input": [
            [
              0,
              3
            ]
          ],
          "expected": {
            "subtotal": 0,
            "discount": 0,
            "tax": 0,
            "total": 0
          }
        },
        {
          "input": [
            [
              50,
              2
            ],
            [
              5,
              1
            ]
          ],
          "expected": {
            "subtotal": 105,
            "discount": 10.5,
            "tax": 7.56,
            "total": 102.06
          }
        },
        {
          "input": [
            [
              1.25,
              4
            ],
            [
              2.1,
              3
            ]
          ],
          "expected": {
            "subtotal": 11.3,
            "discount": 0,
            "tax": 0.9,
            "total": 12.2
          }
        },
        {
          "input": [
            [
              19.99,
              6
            ]
          ],
          "expected": {
            "subtotal": 119.94,
            "discount": 11.99,
            "tax": 8.64,
            "total": 116.59
          }
        }
      ]
    },
    {
      "id": "shipping-quote",
      "pair_group": "shipping-quote",
      "behaviour": "Calculate a parcel shipping charge from its weight, destination zone, and delivery speed.",
      "input_domain": "Weight is a positive exact decimal number of kilograms; zone is local, domestic, or international with a rate of 4, 7, or 15 per kilogram; speed is standard or express. Multiply the raw weight by the zone rate, multiply express by 1.5, then round up the final charge to the next whole unit. Weight is at most 1,000,000 kilograms.",
      "difficulty": "moderate",
      "over_comfort_monolith": false,
      "idiom_tags": [],
      "cases": [
        {
          "input": {
            "weight": 1,
            "zone": "local",
            "speed": "standard"
          },
          "expected": 4
        },
        {
          "input": {
            "weight": 1.2,
            "zone": "local",
            "speed": "standard"
          },
          "expected": 5
        },
        {
          "input": {
            "weight": 2,
            "zone": "domestic",
            "speed": "standard"
          },
          "expected": 14
        },
        {
          "input": {
            "weight": 1,
            "zone": "international",
            "speed": "standard"
          },
          "expected": 15
        },
        {
          "input": {
            "weight": 1,
            "zone": "local",
            "speed": "express"
          },
          "expected": 6
        },
        {
          "input": {
            "weight": 1.1,
            "zone": "local",
            "speed": "express"
          },
          "expected": 7
        },
        {
          "input": {
            "weight": 3,
            "zone": "domestic",
            "speed": "express"
          },
          "expected": 32
        },
        {
          "input": {
            "weight": 0.5,
            "zone": "international",
            "speed": "express"
          },
          "expected": 12
        },
        {
          "input": {
            "weight": 2.25,
            "zone": "international",
            "speed": "standard"
          },
          "expected": 34
        },
        {
          "input": {
            "weight": 4,
            "zone": "local",
            "speed": "standard"
          },
          "expected": 16
        }
      ]
    },
    {
      "id": "csv-summary",
      "pair_group": "csv-summary",
      "behaviour": "Summarize valid sales rows by product, returning total quantity and revenue for each product in name order.",
      "input_domain": "Rows contain a nonempty ASCII product name, positive integer quantity, and finite nonnegative exact decimal unit price. If any row is invalid, return {\"error\":\"invalid_row\"} and no partial summary. Combine exact case-sensitive product names, sum raw revenue, round each final product revenue half up away from zero to two decimals, and sort names by ordinal ASCII order; supplied cases avoid half-cent ties.",
      "difficulty": "advanced",
      "over_comfort_monolith": true,
      "idiom_tags": [
        "templates",
        "generic-aggregation"
      ],
      "cases": [
        {
          "input": [
            {
              "product": "Tea",
              "quantity": 2,
              "unit_price": 3
            }
          ],
          "expected": [
            {
              "product": "Tea",
              "quantity": 2,
              "revenue": 6
            }
          ]
        },
        {
          "input": [],
          "expected": []
        },
        {
          "input": [
            {
              "product": "Pen",
              "quantity": 3,
              "unit_price": 1.2
            },
            {
              "product": "Book",
              "quantity": 1,
              "unit_price": 8
            }
          ],
          "expected": [
            {
              "product": "Book",
              "quantity": 1,
              "revenue": 8
            },
            {
              "product": "Pen",
              "quantity": 3,
              "revenue": 3.6
            }
          ]
        },
        {
          "input": [
            {
              "product": "Tea",
              "quantity": 1,
              "unit_price": 2
            },
            {
              "product": "Tea",
              "quantity": 4,
              "unit_price": 2.5
            }
          ],
          "expected": [
            {
              "product": "Tea",
              "quantity": 5,
              "revenue": 12
            }
          ]
        },
        {
          "input": [
            {
              "product": "A",
              "quantity": 1,
              "unit_price": 0
            }
          ],
          "expected": [
            {
              "product": "A",
              "quantity": 1,
              "revenue": 0
            }
          ]
        },
        {
          "input": [
            {
              "product": "z",
              "quantity": 2,
              "unit_price": 1.11
            },
            {
              "product": "a",
              "quantity": 2,
              "unit_price": 1.11
            }
          ],
          "expected": [
            {
              "product": "a",
              "quantity": 2,
              "revenue": 2.22
            },
            {
              "product": "z",
              "quantity": 2,
              "revenue": 2.22
            }
          ]
        },
        {
          "input": [
            {
              "product": "Mug",
              "quantity": 2,
              "unit_price": 4.5
            },
            {
              "product": "Mug",
              "quantity": 1,
              "unit_price": 4.5
            },
            {
              "product": "Bag",
              "quantity": 1,
              "unit_price": 7
            }
          ],
          "expected": [
            {
              "product": "Bag",
              "quantity": 1,
              "revenue": 7
            },
            {
              "product": "Mug",
              "quantity": 3,
              "revenue": 13.5
            }
          ]
        },
        {
          "input": [
            {
              "product": "x",
              "quantity": 10,
              "unit_price": 0.05
            }
          ],
          "expected": [
            {
              "product": "x",
              "quantity": 10,
              "revenue": 0.5
            }
          ]
        },
        {
          "input": [
            {
              "product": "same",
              "quantity": 1,
              "unit_price": 1
            },
            {
              "product": "Same",
              "quantity": 1,
              "unit_price": 2
            }
