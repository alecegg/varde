    {
      "id": "text-template",
      "pair_group": "text-template",
      "behaviour": "Render a message template by replacing each known placeholder with its supplied value.",
      "input_domain": "Replace each single-brace placeholder `{name}` whose name uses ASCII letters or underscores when a corresponding value exists; preserve unknown placeholders literally. Double braces `{{...}}` mark literal text and are never substituted, even when the enclosed name exists. Inserted values are not recursively processed. All non-placeholder characters are copied verbatim.",
      "difficulty": "moderate",
      "over_comfort_monolith": false,
      "idiom_tags": [
        "templates",
        "formatting"
      ],
      "cases": [
        {
          "input": {
            "template": "Hello {name}",
            "values": {
              "name": "Ada"
            }
          },
          "expected": "Hello Ada"
        },
        {
          "input": {
            "template": "{a}-{b}",
            "values": {
              "a": "x",
              "b": "y"
            }
          },
          "expected": "x-y"
        },
        {
          "input": {
            "template": "plain text",
            "values": {}
          },
          "expected": "plain text"
        },
        {
          "input": {
            "template": "{missing}",
            "values": {}
          },
          "expected": "{missing}"
        },
        {
          "input": {
            "template": "{name}{name}",
            "values": {
              "name": "Jo"
            }
          },
          "expected": "JoJo"
        },
        {
          "input": {
            "template": "{first_name}",
            "values": {
              "first_name": "Lin"
            }
          },
          "expected": "Lin"
        },
        {
          "input": {
            "template": "{name}",
            "values": {
              "name": "{other}",
              "other": "x"
            }
          },
          "expected": "{other}"
        },
        {
          "input": {
            "template": "{a} {unknown} {b}",
            "values": {
              "a": "1",
              "b": "2"
            }
          },
          "expected": "1 {unknown} 2"
        },
        {
          "input": {
            "template": "",
            "values": {
              "x": "y"
            }
          },
          "expected": ""
        },
        {
          "input": {
            "template": "{{name}} {name}",
            "values": {
              "name": "Ada"
            }
          },
          "expected": "{{name}} Ada"
        }
      ]
    },
