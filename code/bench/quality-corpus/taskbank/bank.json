            }
          ],
          "expected": {
            "error": "invalid_row"
          }
        }
      ]
    },
    {
      "id": "retry-policy",
      "pair_group": "retry-policy",
      "behaviour": "Return the scheduled retry delays for a failed operation, capped by the configured maximum delay.",
      "input_domain": "Attempt count is an integer from 0 through 20; initial delay and maximum are positive finite numbers no greater than 1,000,000; multiplier is finite and from 1 through 10. Any invalid field returns {\"error\":\"invalid_policy\"}. Otherwise retry i uses min(initial * multiplier^(i-1), maximum), for i from 1 through attempt count.",
      "difficulty": "moderate",
      "over_comfort_monolith": true,
      "idiom_tags": [
        "error-handling",
        "result-types"
      ],
      "cases": [
        {
          "input": {
            "attempts": 0,
            "initial": 1,
            "multiplier": 2,
            "maximum": 10
          },
          "expected": []
        },
        {
          "input": {
            "attempts": 1,
            "initial": 1,
            "multiplier": 2,
            "maximum": 10
          },
          "expected": [
            1
          ]
        },
        {
          "input": {
            "attempts": 4,
            "initial": 1,
            "multiplier": 2,
            "maximum": 10
          },
          "expected": [
            1,
            2,
            4,
            8
          ]
        },
        {
          "input": {
            "attempts": 5,
            "initial": 1,
            "multiplier": 2,
            "maximum": 10
          },
          "expected": [
            1,
            2,
            4,
            8,
            10
          ]
        },
        {
          "input": {
            "attempts": 3,
            "initial": 5,
            "multiplier": 3,
            "maximum": 20
          },
          "expected": [
            5,
            15,
            20
          ]
        },
        {
          "input": {
            "attempts": 4,
            "initial": 2,
            "multiplier": 1,
            "maximum": 9
          },
          "expected": [
            2,
            2,
            2,
            2
          ]
        },
        {
          "input": {
            "attempts": 3,
            "initial": 0.5,
            "multiplier": 2,
            "maximum": 5
          },
          "expected": [
            0.5,
            1,
            2
          ]
        },
        {
          "input": {
            "attempts": 2,
            "initial": 10,
            "multiplier": 2,
            "maximum": 10
          },
          "expected": [
            10,
            10
          ]
        },
        {
          "input": {
            "attempts": 3,
            "initial": 3,
            "multiplier": 1.5,
            "maximum": 20
          },
          "expected": [
            3,
            4.5,
            6.75
          ]
        },
        {
          "input": {
            "attempts": 6,
            "initial": 2,
            "multiplier": 2,
            "maximum": 9
          },
          "expected": [
            2,
            4,
            8,
            9,
            9,
            9
          ]
        },
        {
          "input": {
            "attempts": 2,
            "initial": 1,
            "multiplier": 0.5,
            "maximum": 10
          },
          "expected": {
            "error": "invalid_policy"
          }
        },
        {
          "input": {
            "attempts": 1,
            "initial": 1,
            "multiplier": 1,
            "maximum": 0
          },
          "expected": {
            "error": "invalid_policy"
          }
        }
      ]
    },
    {
      "id": "shipment-state",
      "pair_group": "shipment-state",
      "behaviour": "Apply a shipment event and return the resulting status or a validation error.",
      "input_domain": "Statuses are created, packed, shipped, delivered, cancelled; events are pack, ship, deliver, cancel. Allowed transitions are created→packed/cancelled, packed→shipped/cancelled, shipped→delivered; all other transitions return error `invalid_transition` without changing status. An unknown status or event also returns {\"error\":\"invalid_transition\"}.",
      "difficulty": "moderate",
      "over_comfort_monolith": true,
      "idiom_tags": [
        "error-handling",
        "state-machine"
      ],
      "cases": [
        {
          "input": {
            "status": "created",
            "event": "pack"
          },
          "expected": {
            "status": "packed"
          }
        },
        {
          "input": {
            "status": "created",
            "event": "cancel"
          },
          "expected": {
            "status": "cancelled"
          }
        },
        {
          "input": {
            "status": "packed",
            "event": "ship"
          },
          "expected": {
            "status": "shipped"
          }
        },
        {
          "input": {
            "status": "packed",
            "event": "cancel"
          },
          "expected": {
            "status": "cancelled"
          }
        },
        {
          "input": {
            "status": "shipped",
            "event": "deliver"
          },
          "expected": {
            "status": "delivered"
          }
        },
        {
          "input": {
            "status": "created",
            "event": "ship"
          },
          "expected": {
            "error": "invalid_transition"
          }
        },
        {
          "input": {
            "status": "delivered",
            "event": "cancel"
          },
          "expected": {
            "error": "invalid_transition"
          }
        },
        {
          "input": {
            "status": "cancelled",
            "event": "pack"
          },
          "expected": {
            "error": "invalid_transition"
          }
        },
        {
          "input": {
            "status": "packed",
            "event": "deliver"
          },
          "expected": {
            "error": "invalid_transition"
          }
        },
        {
          "input": {
            "status": "shipped",
            "event": "pack"
          },
          "expected": {
            "error": "invalid_transition"
          }
        },
        {
          "input": {
            "status": "created",
            "event": "teleport"
          },
          "expected": {
            "error": "invalid_transition"
          }
        }
      ]
    },
    {
      "id": "reservation-calendar",
      "pair_group": "reservation-calendar",
      "behaviour": "Return the identifiers of available appointment slots after applying reservation overlap rules.",
      "input_domain": "Slots have unique nonempty ASCII ids and integer start/end minutes in [0,1440]; reservations have integer start/end minutes in that range. Every interval must satisfy start < end or the result is {\"error\":\"invalid_interval\"}. Intervals are half-open [start,end), so touching endpoints do not overlap. A slot is unavailable if it overlaps any reservation. Return available ids ordered by start minute, then ordinal ASCII id.",
      "difficulty": "advanced",
      "over_comfort_monolith": true,
      "idiom_tags": [
        "ownership-lifetimes",
        "collection-filtering"
      ],
      "cases": [
        {
          "input": {
            "slots": [],
            "reserved": []
          },
          "expected": []
        },
        {
          "input": {
            "slots": [
              {
                "id": "A",
                "start": 540,
                "end": 600
              }
            ],
            "reserved": []
          },
          "expected": [
            "A"
          ]
        },
        {
          "input": {
            "slots": [
              {
                "id": "A",
                "start": 540,
                "end": 600
              }
            ],
            "reserved": [
              {
                "start": 540,
                "end": 600
              }
            ]
          },
          "expected": []
        },
        {
          "input": {
            "slots": [
              {
                "id": "A",
                "start": 480,
                "end": 540
              },
              {
                "id": "B",
                "start": 540,
                "end": 600
              }
            ],
            "reserved": [
              {
                "start": 540,
                "end": 570
              }
            ]
          },
          "expected": [
            "A"
          ]
        },
        {
          "input": {
            "slots": [
              {
                "id": "A",
                "start": 540,
                "end": 600
              }
            ],
            "reserved": [
              {
                "start": 570,
                "end": 630
              }
            ]
          },
          "expected": []
        },
        {
          "input": {
            "slots": [
              {
                "id": "B",
                "start": 600,
                "end": 660
              },
              {
                "id": "A",
                "start": 540,
                "end": 600
              }
            ],
            "reserved": [
              {
                "start": 700,
                "end": 720
              }
            ]
          },
          "expected": [
            "A",
            "B"
          ]
        },
        {
          "input": {
            "slots": [
              {
                "id": "B",
                "start": 540,
                "end": 600
              },
              {
                "id": "A",
                "start": 540,
                "end": 600
              }
            ],
            "reserved": []
          },
          "expected": [
            "A",
            "B"
          ]
        },
        {
          "input": {
            "slots": [
              {
                "id": "A",
                "start": 600,
                "end": 600
              }
            ],
            "reserved": []
          },
          "expected": {
            "error": "invalid_interval"
          }
        },
        {
          "input": {
            "slots": [
              {
                "id": "A",
                "start": 540,
                "end": 600
              }
            ],
            "reserved": [
              {
                "start": 800,
                "end": 800
              }
            ]
          },
          "expected": {
            "error": "invalid_interval"
          }
        },
        {
          "input": {
            "slots": [
              {
                "id": "A",
