{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "{{TOZ_BIN}} --fallback-dir {{TOZ_FALLBACK_SHELL_JSON}} note --harness claude-code", "timeout": 5 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "{{TOZ_BIN}} --fallback-dir {{TOZ_FALLBACK_SHELL_JSON}} capture --hook", "timeout": 20 }
        ]
      }
    ]
  }
}
