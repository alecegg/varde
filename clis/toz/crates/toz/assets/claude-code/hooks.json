{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "{{TOZ_BIN_SHELL}} note --harness claude-code", "timeout": 5 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "{{TOZ_BIN_SHELL}} capture --hook", "timeout": 20 }
        ]
      }
    ]
  }
}
